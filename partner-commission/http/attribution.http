### 전환 수신 (클릭 기반)
POST http://localhost:8080/api/attributions/conversions
Content-Type: application/json

{
  "tenantId": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11",
  "externalId": "order-001",
  "amount": 50000,
  "eventType": "PAYMENT",
  "clickId": "{{clickId}}",
  "referralCode": null
}

